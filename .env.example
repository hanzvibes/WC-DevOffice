# Codex + lifecycle bridge
DEV_OFFICE_URL=https://wc-dev-office.vercel.app
DEV_OFFICE_BRIDGE_TOKEN=your-private-bridge-token

# External lifecycle sources send authenticated events to /api/lifecycle
# Never expose this token to client-side code. Store it as a GitHub Actions secret.

# Customer Ops / Boss Mode (server only)
OPS_ADMIN_PASSWORD=use-a-long-random-password
CUSTOMER_OPS_DATABASE_URL=postgresql://READ_ONLY_USER:ROTATED_PASSWORD@HOST:6543/postgres
